{
    "version": 2,
    "builds": [
        {
            "src": "core/wsgi.py",
            "use": "@vercel/python",
            "config": { "maxLambdaSize": "15mb",
            "runtime": "python3.12", 
            "buildCommand": "bash setup.sh"
         }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "core/wsgi.py"
        },
        {
            "src": "/static/(.*)",
            "dest": "core/static/$1"	
        }
    ]
}