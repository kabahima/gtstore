{
    "version": 2,
    "builds": [
      {
        "src": "core/wsgi.py",
        "use": "@vercel/python",
        "config": {
          "maxLambdaSize": "15mb",
          "runtime": "python3.12",
          "installCommand": "bash setup.sh"  
        }
      }
    ],
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "/core/static/$1"  
      },
      {
        "src": "/(.*)",
        "dest": "core/wsgi.py"
      }
    ],
    "functions": {
      "core/wsgi.py": {
        "includeFiles": "core/static/**" 
      }
    }
  }