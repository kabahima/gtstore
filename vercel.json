{
    "version": 2,
    "functions": {
        "core/wsgi.py": {
            "runtime": "python3.12"
        }
    },
    "limits": {
        "maxLambdaSize": "15mb"
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "core/wsgi.py"
        },
        {
            "src": "/static/(.*)",
            "dest": "core/static/$1"
        }
    ]
}
