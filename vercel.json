{
    "version": 2,
    "functions": {
        "core/wsgi.py": {
            "runtime": "python3.12",
            "maxLambdaSize": "15mb"
        }
    },
    "build": {
        "env": {
            "PYTHON_VERSION": "3.12"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "core/wsgi.py"
        },
        {
            "src": "/static/(.*)",
            "dest": "core/static/$1"
        }
    ]
}
