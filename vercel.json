{
    "version": 2,
    "functions": {
      "core/wsgi.py": {
        "memory": 512,
        "maxDuration": 60,
        "includeFiles": "core/static/**",
        "runtime": "python3.12",  
        "handler": "core/wsgi.py",  
        "maxLambdaSize": "15mb" 
      },
      "core/static/**": { 
          "memory": 128,
          "maxDuration": 10,
          "type": "static"
      }
    },
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "/core/static/$1"
      },
      {
        "src": "/(.*)",
        "dest": "core/wsgi.py"
      }
    ]
  }